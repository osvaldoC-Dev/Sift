  "transitions": [
    { "type": "claim", "from": "provisional", "to": "active", "requires": "explicit" },
    { "type": "assumption", "from": "provisional", "to": "adopted", "requires": "explicit" },
    { "type": "decision", "from": "provisional", "to": "adopted", "requires": "explicit" }
